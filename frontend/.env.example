# Local settings for the Recon app. Never commit this file (.env is git-ignored).

# 1. LLM: Gemini free tier for W1-W2 (decision D-017).
#    Get a free key at https://aistudio.google.com/apikey and paste it after the = sign.
GEMINI_API_KEY=
# Free-tier keys for the W2.6 benchmark and optional extraction: https://console.groq.com/keys and https://openrouter.ai/keys
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional chat models from https://build.nvidia.com/settings/api-keys (free tier)
NVIDIA_API_KEY=
# google | groq | openrouter | nvidia (chat; the benchmark picks the provider per config)
LLM_PROVIDER=google
LLM_MODEL=gemini-flash-lite-latest

# 2. LLM cost guards (decision D-016).
LLM_DAILY_TOKEN_BUDGET=200000
LLM_MAX_OUTPUT_TOKENS=1024
# Provider requests (each model step is one request), counted per provider for the chat. Optional. Unset: google gets
# 18 per day and 4 per minute (the free key allows 20 and 5), other providers have no request limit. Set: applies to every provider.
# LLM_DAILY_REQUEST_BUDGET=18
# LLM_MINUTE_REQUEST_BUDGET=4
CHAT_RATE_LIMIT_PER_MIN=10
GLOBAL_RATE_LIMIT_PER_MIN=30
# Set to true only behind a proxy that overwrites X-Forwarded-For (enables per-IP limits).
TRUST_PROXY=false

# 3. Stellar: the agent wallet is pinned to testnet (no URL setting needed).
#    AGENT_PUBLIC_KEY: the public key (G...) of the testnet agent wallet. Safe for the web app; set this one on Vercel.
#    Leave empty locally to use the "Create wallet" button (it saves .agent-wallet.json, git-ignored).
AGENT_PUBLIC_KEY=
#    AGENT_SECRET_KEY: operator-script only (npm run feed:publish, via agent/signer.ts). The web app never reads it.
#    Never set it on Vercel. It must match AGENT_PUBLIC_KEY when both are set.
#    Testnet only: never put a mainnet key or a wallet with real money here.
AGENT_SECRET_KEY=

# 4. Revenue stays hidden on testnet (golden rule 7).
PRICING_ENABLED=false

# 4b. The x402 testnet rail for GET /api/check/detail (stellar:testnet, test USDC; off while X402_ENABLED is not "true").
#     testnet placeholder set by the operator; never commit a value. The check:paid CLI does not read this file: set X402_PAY_TO, X402_TESTNET_AMOUNT and X402_PAYER_IDENTITY inline.
#     Chat: the get_evidence_bundle tool reads the same switch. With the X402 names below left empty, the tool answers "not available" and the chat card says so.
#     To try the Unlock evidence card locally, set X402_ENABLED to true plus the pay-to address and the testnet amount, then run npm run dev. The user's browser creates its own
#     testnet payer wallet (kept in localStorage, never sent to the server) and pays the same-origin detail route. Keep the live app with X402_ENABLED unset.
X402_ENABLED=
X402_PAY_TO=
X402_TESTNET_AMOUNT=
X402_FACILITATOR_URL=
X402_PAYER_IDENTITY=
# Rate limits of the check routes (empty = built-in defaults; the global bucket always applies, per-IP needs TRUST_PROXY=true).
CHECK_RATE_LIMIT_PER_MIN=
CHECK_GLOBAL_RATE_LIMIT_PER_MIN=
PAID_RATE_LIMIT_PER_MIN=
PAID_GLOBAL_RATE_LIMIT_PER_MIN=
# MCP endpoint POST /api/mcp: rate limits (empty = built-in defaults) and the web origins allowed to call it (comma-separated; empty = none).
MCP_RATE_LIMIT_PER_MIN=
MCP_GLOBAL_RATE_LIMIT_PER_MIN=
WALLET_RATE_LIMIT_PER_MIN=
WALLET_GLOBAL_RATE_LIMIT_PER_MIN=
MCP_ALLOWED_ORIGINS=

# Sign-in with GitHub (Supabase): required to use the agent chat once these two values are set; also saves chats and paid evidence. See ../supabase/README.md.
# Both values are public by design. Never put a Supabase service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to false only for local work to let the chat run without signing in. Unset: the chat needs a signed-in user (when the two values above exist).
# Fact sheets, the feed and /api/check stay public either way.
AUTH_REQUIRED=

# Provider and model for batch claim extraction (npm run extract:claims). The provider defaults to LLM_PROVIDER.
# On google the model defaults to gemini-3.7-flash (the W2.6 benchmark pick); elsewhere to LLM_MODEL.
# If Flash returns 503s for long, gemini-flash-lite-latest is the runner-up.
# LLM_EXTRACT_PROVIDER=google
# LLM_EXTRACT_MODEL=gemini-3.7-flash
# Tokens a batch extraction leaves for the chat app each day
# LLM_APP_RESERVE_TOKENS=50000

# SEC EDGAR requires a contact email in the User-Agent (npm run map:sec / snapshot:docs)
SEC_CONTACT_EMAIL=

# Optional overrides
# ASSETS_CSV=../data/assets.csv
# SNAPSHOTS_DIR=../data/snapshots
