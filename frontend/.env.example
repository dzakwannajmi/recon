# Local settings for the Recon app. Never commit this file (.env is git-ignored).

# 1. LLM: Gemini free tier for W1-W2 (decision D-017).
#    Get a free key at https://aistudio.google.com/apikey and paste it after the = sign.
GEMINI_API_KEY=
LLM_PROVIDER=google
LLM_MODEL=gemini-flash-latest

# 2. LLM cost guards (decision D-016).
LLM_DAILY_TOKEN_BUDGET=200000
LLM_MAX_OUTPUT_TOKENS=1024
CHAT_RATE_LIMIT_PER_MIN=10
GLOBAL_RATE_LIMIT_PER_MIN=30
# Set to true only behind a proxy that overwrites X-Forwarded-For (enables per-IP limits).
TRUST_PROXY=false

# 3. Stellar: the agent wallet is pinned to testnet (no URL setting needed).
#    Optional: a TESTNET secret key (S...). Leave empty and use the "Create wallet" button instead.
#    Never put a mainnet key or a wallet with real money here.
AGENT_SECRET_KEY=

# 4. Revenue stays hidden on testnet (golden rule 7).
PRICING_ENABLED=false
